<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style
        name="Theme.CMFLIXNative"
        parent="Theme.AppCompat.DayNight.NoActionBar">

        <item name="android:fontFamily">
            sans
        </item>

        <item name="android:windowActionModeOverlay">
            true
        </item>

        <item name="android:colorAccent">
            @color/white
        </item>

        <item name="android:navigationBarColor">
            @color/black
        </item>

        <item name="android:statusBarColor">
            @color/black
        </item>

        <item name="android:windowLightStatusBar">
            false
        </item>

        <item name="android:windowBackground">
            @color/dark_bg
        </item>

    </style>

    <style
        name="Theme.CMFLIXNative.Starting"
        parent="Theme.SplashScreen">

        <!--
            my_logo.png ရဲ့ အပြင်ထောင့်မှာ အနက်ရောင် pixel/canvas
            ပါနေသောကြောင့် splash background ကို အနက်ထားပါမယ်။
            ဒါဆို လေးထောင့်အနားသတ် မမြင်ရတော့ပါ။
        -->
        <item name="windowSplashScreenBackground">
            @color/black
        </item>

        <!--
            PNG ကို တိုက်ရိုက်မသုံးဘဲ safe-size wrapper သုံးပါမယ်။
        -->
        <item name="windowSplashScreenAnimatedIcon">
            @drawable/splash_logo
        </item>

        <item name="windowSplashScreenIconBackgroundColor">
            @color/black
        </item>

        <!-- Android 12 မှာ animation duration ကိုသိစေရန် -->
        <item name="windowSplashScreenAnimationDuration">
            700
        </item>

        <item name="postSplashScreenTheme">
            @style/Theme.CMFLIXNative
        </item>

    </style>

</resources>
