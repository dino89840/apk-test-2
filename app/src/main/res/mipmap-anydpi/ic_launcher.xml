<?xml version="1.0" encoding="utf-8"?>
<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- App icon background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dark_bg" />
        </shape>
    </item>

    <!-- Logo -->
    <item
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp">

        <bitmap
            android:src="@drawable/my_logo"
            android:gravity="fill"
            android:filter="true" />

    </item>

</layer-list>
