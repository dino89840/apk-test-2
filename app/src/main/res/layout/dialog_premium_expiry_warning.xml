<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/expiryWarningCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/premium_expiry_card_bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:elevation="18dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="24dp"
    android:paddingEnd="22dp"
    android:paddingBottom="20dp">

    <FrameLayout
        android:layout_width="94dp"
        android:layout_height="82dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <View
            android:id="@+id/expiryIconGlow"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="center"
            android:background="@drawable/premium_expiry_icon_bg" />

        <ImageView
            android:id="@+id/expiryCrownIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:contentDescription="Premium expiry warning"
            android:padding="5dp"
            android:src="@drawable/ic_vip_crown" />

        <TextView
            android:id="@+id/expirySparkleLeft"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="start|top"
            android:gravity="center"
            android:text="✦"
            android:textColor="#FFE135"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/expirySparkleRight"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="end|bottom"
            android:gravity="center"
            android:text="✦"
            android:textColor="#FF9F43"
            android:textSize="16sp"
            android:textStyle="bold" />

    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="ပရီမီယံသက်တမ်း သတိပေးချက်"
        android:textColor="#FFE135"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/expiryWarningMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="လူကြီးမင်း ဝယ်ယူထားသော ပရီမီယံသက်တမ်းမှာ ကုန်ဆုံးရန် ၁ ရက်သာ ကျန်ပါတော့သည်။"
        android:textColor="#FFFFFF"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/expiryDateText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/premium_expiry_date_bg"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:textColor="#D6D7DD"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/expiryRenewButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/premium_telegram_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="သက်တမ်းတိုးရန် ဆက်သွယ်မည်"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/expiryLaterButton"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="9dp"
        android:background="@drawable/premium_close_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="နောက်မှလုပ်မည်"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
