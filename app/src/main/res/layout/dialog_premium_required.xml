<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="164dp"
        android:background="@drawable/premium_dialog_header_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="17dp">

        <TextView
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:background="@drawable/premium_dialog_icon_bg"
            android:gravity="center"
            android:text="★"
            android:textColor="#FFFFFF"
            android:textSize="29sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Premium Required"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/premium_dialog_body_bg"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="21dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Premium ဝယ်ယူပါက&#10;Movie အားလုံးကြည့်ရှုနိူင်ခြင်း။&#10;Movie အားလုံး Downloadလုပ်နိူင်ခြင်း။"
            android:textColor="#C9C6D0"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/premiumTelegramButton"
            android:layout_width="match_parent"
            android:layout_height="49dp"
            android:layout_marginTop="19dp"
            android:background="@drawable/premium_telegram_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Premium ဝယ်ယူရန်"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/premiumCloseButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/premium_close_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="ပိတ်မည်"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
