<?xml version="1.0" encoding="utf-8"?>
<!--
    VIP price banner — home feed ရဲ့ ပထမ item။
    Fixed header ထဲက ဟောင်းကို ဒီမှာပြောင်းထားသည်
    (attribute များ အတူတူ)။
-->
<ImageView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vipBannerImage"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="2dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="10dp"
    android:adjustViewBounds="true"
    android:background="@drawable/vip_banner_rounded_bg"
    android:clickable="true"
    android:clipToOutline="true"
    android:contentDescription="Open Telegram to buy VIP"
    android:focusable="true"
    android:maxHeight="190dp"
    android:scaleType="fitCenter"
    android:src="@drawable/vip_plan_banner" />
