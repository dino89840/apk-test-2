<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="7dp"
    android:layout_marginTop="7dp"
    android:layout_marginEnd="7dp"
    android:layout_marginBottom="7dp"
    android:background="@drawable/card_bg"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingBottom="7dp">

    <!--
        clipToOutline နဲ့ poster image ရဲ့
        အပေါ်ဘက်ထောင့်နှစ်ခုကို ကွေးထားသည်။
    -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:background="@drawable/poster_rounded_bg"
        android:clipChildren="true"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#20232A"
            android:contentDescription="Movie poster"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/vipRibbon"
            android:layout_width="82dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:background="@color/brand_red"
            android:elevation="7dp"
            android:gravity="center"
            android:rotation="45"
            android:text="VIP"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:translationX="18dp"
            android:translationY="11dp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/favoriteRemove"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/favorite_remove_bg"
            android:contentDescription="Remove from favorites"
            android:elevation="8dp"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/white"
            android:visibility="gone" />

    </FrameLayout>

    <TextView
        android:id="@+id/movieTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:minLines="2"
        android:paddingStart="7dp"
        android:paddingTop="7dp"
        android:paddingEnd="7dp"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="7dp"
        android:paddingTop="2dp"
        android:paddingEnd="7dp"
        android:textColor="@color/gray_text"
        android:textSize="10sp" />

</LinearLayout>
