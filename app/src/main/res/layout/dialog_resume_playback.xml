<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/resumeDialogCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/resume_dialog_bg"
    android:elevation="22dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="22dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <TextView
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:background="@drawable/premium_expiry_icon_bg"
        android:gravity="center"
        android:text="◷"
        android:textColor="#FFC928"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:gravity="center"
        android:text="ကြည့်လက်စ နေရာမှတ်မိပါသည်"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/resumeTimeText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="#A7A9B2"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:text="ဆက်ကြည့်မည် သို့မဟုတ် အစမှ ပြန်ကြည့်မည်ကို ရွေးချယ်ပါ။"
        android:textColor="#858995"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/resumeRestartButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/resume_secondary_button_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="အစမှကြည့်မည်"
            android:textColor="#D5D6DB"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/resumeContinueButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/resume_primary_button_bg"
            android:clickable="true"
            android:elevation="5dp"
            android:focusable="true"
            android:gravity="center"
            android:text="ဆက်ကြည့်မည်"
            android:textColor="#191407"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
