<?xml version="1.0" encoding="utf-8"?>
<!--
    Single-choice item for the premium Sort by dialog.
    Root is a RadioButton (implements Checkable) so the
    dialog's ListView CHOICE_MODE_SINGLE checks it
    automatically. Gold radio tint, white text.
-->
<RadioButton
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/text1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:gravity="center_vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:buttonTint="@color/gold"
    android:textColor="@color/white"
    android:textSize="16sp" />