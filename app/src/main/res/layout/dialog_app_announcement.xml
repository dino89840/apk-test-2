<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/announcement_dialog_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="20dp"
    android:paddingEnd="22dp"
    android:paddingBottom="18dp">

    <ImageView
        android:id="@+id/announcementIcon"
        android:layout_width="74dp"
        android:layout_height="74dp"
        android:contentDescription="Notification"
        android:src="@drawable/ic_announcement_mail" />

    <TextView
        android:id="@+id/announcementTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="အသိပေးချက်"
        android:textColor="#FFFFFF"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/announcementMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:maxHeight="280dp"
        android:scrollbars="vertical"
        android:textColor="#D7DAE2"
        android:textIsSelectable="true"
        android:textSize="14sp" />

    <Button
        android:id="@+id/announcementClose"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/auth_primary_button_bg"
        android:backgroundTint="@null"
        android:minHeight="0dp"
        android:text="နားလည်ပါပြီ"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
