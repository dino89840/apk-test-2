<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/newAccountCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/premium_expiry_card_bg"
    android:elevation="20dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="19dp"
    android:paddingTop="18dp"
    android:paddingEnd="19dp"
    android:paddingBottom="18dp">

    <FrameLayout
        android:layout_width="76dp"
        android:layout_height="76dp">

        <View
            android:id="@+id/newAccountIconGlow"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_gravity="center"
            android:background="@drawable/premium_expiry_icon_bg" />

        <TextView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="✓"
            android:textColor="#17130A"
            android:textSize="28sp"
            android:textStyle="bold" />

    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Account ဖွင့်ခြင်း အောင်မြင်ပါသည်"
        android:textColor="#FFE06A"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="လူကြီးမင်း၏ username နှင့် password ကို မှတ်သားထားလိုက်ပါ။ ဒီအချက်အလက်ကို နောက်တစ်ကြိမ် ပြန်မပြတော့ပါ။"
        android:textColor="#D6D8E0"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="USERNAME"
        android:textColor="#8E94A3"
        android:textSize="10sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="47dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/search_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="13dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/newAccountUsername"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textIsSelectable="true"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/copyUsernameButton"
            android:layout_width="64dp"
            android:layout_height="34dp"
            android:background="@drawable/premium_close_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="COPY"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:text="PASSWORD"
        android:textColor="#8E94A3"
        android:textSize="10sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="47dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/search_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="13dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/newAccountPassword"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textIsSelectable="true"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/copyPasswordButton"
            android:layout_width="64dp"
            android:layout_height="34dp"
            android:background="@drawable/premium_close_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="COPY"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:id="@+id/newAccountDoneButton"
        android:layout_width="match_parent"
        android:layout_height="47dp"
        android:layout_marginTop="17dp"
        android:background="@drawable/premium_telegram_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="မှတ်သားထားပြီးပါပြီ"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
