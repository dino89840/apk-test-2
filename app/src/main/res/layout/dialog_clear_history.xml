<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/download_dialog_bg"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="26dp"
    android:paddingEnd="24dp"
    android:paddingBottom="22dp">

    <TextView
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/download_dialog_icon_bg"
        android:gravity="center"
        android:text="!"
        android:textColor="#17131F"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/clearDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="Clear History"
        android:textColor="#F5C76B"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/clearDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="History ကို ရှင်းမှာ သေချာပါသလား?"
        android:textColor="#B8B2C2"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/clearDialogConfirm"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/download_adm_button_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="ရှင်းမည်"
        android:textColor="#171008"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/clearDialogCancel"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="11dp"
        android:background="@drawable/download_cancel_button_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="မလုပ်တော့ပါ"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
