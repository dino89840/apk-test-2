<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/auth_screen_bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:paddingStart="22dp"
        android:paddingTop="30dp"
        android:paddingEnd="22dp"
        android:paddingBottom="30dp">

        <LinearLayout
            android:id="@+id/authCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/auth_card_bg"
            android:elevation="18dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="26dp"
            android:paddingEnd="22dp"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/authLogo"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/my_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:letterSpacing="0.12"
                android:text="CMFLIX"
                android:textColor="#F5C451"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/authHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/authSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:textColor="#9EA3B2"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/authError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/error_bg"
                android:padding="12dp"
                android:textColor="#FFB4AB"
                android:textSize="13sp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/usernameInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:autofillHints="newUsername"
                android:background="@drawable/search_bg"
                android:hint="Username"
                android:imeOptions="actionNext"
                android:inputType="textNoSuggestions"
                android:maxLines="1"
                android:paddingStart="17dp"
                android:paddingEnd="17dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#777D8D"
                android:textSize="15sp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/emailInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:autofillHints="emailAddress"
                android:background="@drawable/search_bg"
                android:hint="Email address"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:paddingStart="17dp"
                android:paddingEnd="17dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#777D8D"
                android:textSize="15sp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/identityInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:autofillHints="username,emailAddress"
                android:background="@drawable/search_bg"
                android:hint="Username or email"
                android:imeOptions="actionNext"
                android:inputType="textNoSuggestions"
                android:maxLines="1"
                android:paddingStart="17dp"
                android:paddingEnd="17dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#777D8D"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/passwordInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:autofillHints="password"
                android:background="@drawable/search_bg"
                android:hint="Password"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingStart="17dp"
                android:paddingEnd="17dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#777D8D"
                android:textSize="15sp" />

            <CheckBox
                android:id="@+id/rememberCheckBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:buttonTint="@drawable/auth_checkbox_tint"
                android:checked="false"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="Remember me"
                android:textColor="#D6D8E0"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/authProgress"
                style="?android:attr/progressBarStyle"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:indeterminateTint="#F5C451"
                android:visibility="gone" />

            <Button
                android:id="@+id/authSubmit"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/auth_primary_button_bg"
                android:backgroundTint="@null"
                android:elevation="5dp"
                android:text="LOGIN ဝင်မည်"
                android:textAllCaps="false"
                android:textColor="#15120A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/authSwitch"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/auth_secondary_button_bg"
                android:backgroundTint="@null"
                android:textAllCaps="false"
                android:textColor="#ECEEF5"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Secure access  •  Premium entertainment"
                android:textColor="#666C7A"
                android:textSize="11sp" />

        </LinearLayout>

    </FrameLayout>

</ScrollView>
