<?xml version="1.0" encoding="utf-8"?>
<!--
    DrawerLayout: main content + hamburger navigation drawer.
    The drawer itself is a plain menu (drawer_menu.xml) and
    triggers no network request when opened.
-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg">

<!--
    DrawerLayout မှာ direct content child တစ်ခုပဲရှိစေရန်
    app content နှင့် loading overlay ကို FrameLayout တစ်ခုထဲ
    စုထားသည်။
-->
<FrameLayout
    android:id="@+id/mainContentContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dark_bg"
        android:orientation="vertical">

       <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/drawerButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Open menu"
            android:padding="9dp"
            android:src="@drawable/ic_menu_hamburger" />

        <!--
            App logo ကို drawer header မှာထားပြီးဖြစ်၍
            top bar မှာ ထပ်မထားပါ (uncluttered)။
        -->

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/search_bg"
            android:drawableStart="@drawable/search_icon"
            android:drawablePadding="7dp"
            android:drawableTint="@color/gray_text"
            android:gravity="center_vertical"
            android:hint="Search"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLength="50"
            android:maxLines="1"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textColorHint="@color/gray_text"
            android:textSize="12sp" />

        <Button
            android:id="@+id/accountButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:maxWidth="118dp"
            android:background="@drawable/account_badge_bg"
            android:backgroundTint="@null"
            android:ellipsize="end"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:text="LOGIN"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
    android:id="@+id/premiumButton"
    android:layout_width="wrap_content"
    android:layout_height="38dp"
    android:layout_marginStart="8dp"
    android:background="@drawable/vip_badge_bg"
    android:backgroundTint="@null"
    android:clickable="true"
    android:drawableStart="@drawable/ic_vip_crown"
    android:drawablePadding="7dp"
    android:focusable="true"
    android:gravity="center"
    android:includeFontPadding="false"
    android:minHeight="0dp"
    android:minWidth="88dp"
    android:paddingStart="12dp"
    android:paddingEnd="14dp"
    android:singleLine="true"
    android:text="Buy VIP"
    android:textAllCaps="false"
    android:textColor="#FFE135"
    android:textSize="11sp"
    android:textStyle="bold"
    android:visibility="gone" />


    </LinearLayout>

    <!--
        VIP price banner ကို home feed ရဲ့ ပထမ item
        (VipBannerAdapter) အဖြစ် ပြောင်းထားသည် —
        scroll နဲ့အတူ အပေါ်ကို ပါသွားစေရန်။
    -->


   

<LinearLayout
    android:id="@+id/searchHistoryRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp"
    android:visibility="gone">

    <HorizontalScrollView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/searchHistoryContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <TextView
        android:id="@+id/clearSearchHistoryButton"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="4dp"
        android:text="CLEAR"
        android:textColor="@color/brand_red"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>

    
    <!--
        Full-grid view (Horror / 18+ / Continue / Recent /
        Downloads / Favorites) မှာ back header ပြမည်။
    -->
    <LinearLayout
        android:id="@+id/localHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="5dp"
        android:paddingEnd="16dp"
        android:paddingBottom="7dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/localBackButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back to home"
            android:padding="10dp"
            android:src="@drawable/ic_auth_back" />

        <TextView
            android:id="@+id/localHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!--
        Category chips removed: categories now live in the bottom
        navigation (Home / Horror / 18+ Nosub / 18+ Mmsub) and in
        the hamburger drawer. No count badges anymore.
    -->

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical|end"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!--
        Continue / Recent / Downloads စသော local category များတွင်
        Java က လိုအပ်ချိန်မှသာ CLEAR button ကိုပြမည်။
    -->
    <TextView
        android:id="@+id/localClearButton"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:gravity="center"
        android:paddingStart="12dp"
        android:text="CLEAR"
        android:textColor="@color/brand_red"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Grid 2 columns <-> 3 columns toggle -->
    <ImageButton
        android:id="@+id/gridToggleButton"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Toggle grid columns"
        android:padding="9dp"
        android:src="@drawable/ic_grid_toggle" />

</LinearLayout>


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="24dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:textColor="@color/gray_text"
            android:textSize="14sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="18dp"
            android:visibility="gone" />

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <include layout="@layout/shimmer_grid_placeholder" />

        </com.facebook.shimmer.ShimmerFrameLayout>

    </FrameLayout>

    <!-- Premium bottom navigation: Home / Horror / 18+ Nosub / 18+ Mmsub -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1E222B" />

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#101218"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:id="@+id/navHomeIcon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="7dp"
                android:src="@drawable/ic_nav_home" />

            <TextView
                android:id="@+id/navHomeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="3dp"
                android:text="Home"
                android:textSize="11sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navHorror"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:id="@+id/navHorrorIcon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="7dp"
                android:src="@drawable/ic_nav_film" />

            <TextView
                android:id="@+id/navHorrorLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="3dp"
                android:text="Horror"
                android:textSize="11sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navNosub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:id="@+id/navNosubIcon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="7dp"
                android:src="@drawable/ic_nav_play" />

            <TextView
                android:id="@+id/navNosubLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="3dp"
                android:text="18+ Nosub"
                android:textSize="11sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navMmsub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:id="@+id/navMmsubIcon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="7dp"
                android:src="@drawable/ic_nav_play" />

            <TextView
                android:id="@+id/navMmsubLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="3dp"
                android:text="18+ Mmsub"
                android:textSize="11sp" />

        </LinearLayout>

        <!--
            မြန်မာ (samusar) tab — backend /app-content ရဲ့
            myanmar.enabled kill-switch မှ visibility
            ကို ထိန်းသည်။ Default GONE (fail-closed)
            content check ပြီးမှ ပြမည်။
        -->
        <LinearLayout
            android:id="@+id/navMyanmar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/navMyanmarIcon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="7dp"
                android:src="@drawable/ic_nav_film" />

            <TextView
                android:id="@+id/navMyanmarLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="3dp"
                android:text="မြန်မာ"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

    </LinearLayout>

    <!--
        ဒီ overlay က app content ပေါ်မှာသာရှိမည်။
        Drawer menu ပေါ်ကို ဖုံးပြီး click intercept
        မလုပ်နိုင်တော့ပါ။
    -->
    <FrameLayout
        android:id="@+id/homeLoadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#050609"
        android:clickable="true"
        android:focusable="true"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="#E8B93E" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:letterSpacing="0.12"
                android:text="LOADING"
                android:textColor="#8E94A3"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>

<!--
    Drawer view ကို MainContentContainer နောက်မှာထားသည်။
    Drawer ဖွင့်ထားစဉ် drawer menu က loading overlay ထက်
    အပေါ်မှာရှိမည်။
-->
<include layout="@layout/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>