<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:orientation="vertical">

       <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/app_logo" />

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/search_bg"
            android:drawableStart="@drawable/search_icon"
            android:drawablePadding="7dp"
            android:drawableTint="@color/gray_text"
            android:gravity="center_vertical"
            android:hint="Search"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLength="50"
            android:maxLines="1"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textColorHint="@color/gray_text"
            android:textSize="12sp" />

        <Button
            android:id="@+id/accountButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:maxWidth="118dp"
            android:background="@drawable/account_badge_bg"
            android:backgroundTint="@null"
            android:ellipsize="end"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:text="LOGIN"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
    android:id="@+id/premiumButton"
    android:layout_width="wrap_content"
    android:layout_height="38dp"
    android:layout_marginStart="8dp"
    android:background="@drawable/vip_badge_bg"
    android:backgroundTint="@null"
    android:clickable="true"
    android:drawableStart="@drawable/ic_vip_crown"
    android:drawablePadding="7dp"
    android:focusable="true"
    android:gravity="center"
    android:includeFontPadding="false"
    android:minHeight="0dp"
    android:minWidth="88dp"
    android:paddingStart="12dp"
    android:paddingEnd="14dp"
    android:singleLine="true"
    android:text="Buy VIP"
    android:textAllCaps="false"
    android:textColor="#FFE135"
    android:textSize="11sp"
    android:textStyle="bold"
    android:visibility="gone" />


    </LinearLayout>

    <ImageView
    android:id="@+id/vipPlanBanner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="2dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="10dp"
    android:adjustViewBounds="true"
    android:background="@drawable/vip_banner_rounded_bg"
    android:clickable="true"
    android:clipToOutline="true"
    android:contentDescription="Open Telegram to buy VIP"
    android:focusable="true"
    android:maxHeight="190dp"
    android:scaleType="fitCenter"
    android:src="@drawable/vip_plan_banner" />


   

<LinearLayout
    android:id="@+id/searchHistoryRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp"
    android:visibility="gone">

    <HorizontalScrollView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/searchHistoryContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <TextView
        android:id="@+id/clearSearchHistoryButton"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="4dp"
        android:text="CLEAR"
        android:textColor="@color/brand_red"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>

    
    <HorizontalScrollView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/categoryBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="7dp" />

</HorizontalScrollView>

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical|end"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!--
        MainActivity.java က sectionTitle ID ကိုအသုံးပြုထားသောကြောင့်
        View ကိုလုံးဝမဖျက်ဘဲ GONE လုပ်ထားသည်။
        GONE ဖြစ်သောကြောင့် စာလည်းမမြင်ရ၊ နေရာလည်းမယူပါ။
    -->
    <TextView
        android:id="@+id/sectionTitle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="Movies"
        android:visibility="gone" />

    <!--
        Continue / Recent / Downloads စသော local category များတွင်
        Java က လိုအပ်ချိန်မှသာ CLEAR button ကိုပြမည်။
    -->
    <TextView
        android:id="@+id/localClearButton"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:gravity="center"
        android:paddingStart="12dp"
        android:text="CLEAR"
        android:textColor="@color/brand_red"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

</LinearLayout>


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="24dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:textColor="@color/gray_text"
            android:textSize="14sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="18dp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
