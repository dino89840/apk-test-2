<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg">

    <!--
        Screen အမြင့်သေးသောဖုန်းနှင့် font size ကြီးထားသောဖုန်းများအတွက်
        ScrollView ကို ဆက်ထားသည်။
        ပုံမှန်ဖုန်းများတွင် Logout အထိ တစ်မျက်နှာထဲမြင်နိုင်အောင်
        header, rows နှင့် buttons များကို ကျစ်လျစ်ထားသည်။
    -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Compact profile header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="225dp"
                android:background="@drawable/profile_header_bg"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/profileBackButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/profile_back_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="#FFFFFF"
                    android:textSize="31sp" />

                <ImageView
    android:layout_width="72dp"
    android:layout_height="72dp"
    android:layout_gravity="center_horizontal"
    android:layout_marginTop="0dp"
    android:background="@drawable/profile_avatar_bg"
    android:contentDescription="Profile"
    android:padding="18dp"
    android:scaleType="fitCenter"
    android:src="@drawable/ic_profile_user"
    android:tint="#FFFFFF" />


                <TextView
                    android:id="@+id/profileUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="ACCOUNT"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/profileAccountStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/profile_status_bg"
                    android:gravity="center"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:text="Free member"
                    android:textColor="#FFD2D2"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Profile information and actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/profile_card_bg"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="8dp">

                    <!-- Email -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
    android:layout_width="38dp"
    android:layout_height="38dp"
    android:background="@drawable/profile_icon_email_bg"
    android:contentDescription="Email"
    android:padding="9dp"
    android:scaleType="fitCenter"
    android:src="@drawable/ic_profile_email"
    android:tint="#FFFFFF" />


                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Email"
                                android:textColor="@color/gray_text"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/profileEmail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="—"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="50dp"
                        android:background="#292C35" />

                    <!-- Account security -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
    android:layout_width="38dp"
    android:layout_height="38dp"
    android:background="@drawable/profile_icon_security_bg"
    android:contentDescription="Account security"
    android:padding="9dp"
    android:scaleType="fitCenter"
    android:src="@drawable/ic_profile_security"
    android:tint="#FFFFFF" />


                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Account Security"
                                android:textColor="@color/gray_text"
                                android:textSize="11sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="Password Protected"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="50dp"
                        android:background="#292C35" />

                    <!-- Current plan -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
    android:layout_width="38dp"
    android:layout_height="38dp"
    android:background="@drawable/profile_icon_plan_bg"
    android:contentDescription="Current plan"
    android:padding="9dp"
    android:scaleType="fitCenter"
    android:src="@drawable/ic_vip_crown"
    android:tint="#FFFFFF" />


                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Current Plan"
                                android:textColor="@color/gray_text"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/profilePlan"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="Free Plan"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="50dp"
                        android:background="#292C35" />

                    <!-- Expiry -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
    android:layout_width="38dp"
    android:layout_height="38dp"
    android:background="@drawable/profile_icon_expiry_bg"
    android:contentDescription="Plan expiry"
    android:padding="9dp"
    android:scaleType="fitCenter"
    android:src="@drawable/ic_profile_calendar"
    android:tint="#FFFFFF" />


                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Expired At"
                                android:textColor="@color/gray_text"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/profileExpiry"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Expired"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/profile_card_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="5dp">

                    <EditText
                        android:id="@+id/promoCodeInput"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Promo Code"
                        android:imeOptions="actionDone"
                        android:inputType="textCapCharacters"
                        android:maxLength="32"
                        android:maxLines="1"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="@color/gray_text"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/promoRedeemButton"
                        android:layout_width="96dp"
                        android:layout_height="44dp"
                        android:background="@drawable/profile_change_button_bg"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:text="REDEEM"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <Button
                    android:id="@+id/changePasswordButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/profile_change_button_bg"
                    android:minHeight="0dp"
                    android:text="Change Password"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
    android:id="@+id/profileContactButton"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:layout_marginTop="16dp"
    android:background="@drawable/profile_contact_button_bg"
    android:drawableStart="@drawable/ic_telegram"
    android:drawablePadding="10dp"
    android:drawableTint="#FFFFFF"
    android:gravity="center"
    android:minHeight="0dp"
    android:text="Contact Us"
    android:textAllCaps="false"
    android:textColor="#FFFFFF"
    android:textSize="15sp"
    android:textStyle="bold" />

<Button
    android:id="@+id/profileLogoutButton"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:layout_marginTop="10dp"
    android:background="@drawable/profile_logout_button_bg"
    android:minHeight="0dp"
    android:text="Logout"
    android:textAllCaps="false"
    android:textColor="#FFFFFF"
    android:textSize="15sp"
    android:textStyle="bold" />


            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Loading indicator ကို overlay လုပ်ထားလို့ layout အမြင့်မတိုးတော့ပါ -->
    <ProgressBar
        android:id="@+id/profileProgress"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="center"
        android:elevation="20dp"
        android:visibility="gone" />

</FrameLayout>
