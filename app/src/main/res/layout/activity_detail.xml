<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

              <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/backdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#20232A"
                android:contentDescription="Movie backdrop"
                android:scaleType="centerCrop" />

            <!--
                Cover ပုံအောက်ခြေ gradient။
                Poster နဲ့ cover ပုံကြား contrast ပိုကောင်းစေပါတယ်။
            -->
            <View
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_gravity="bottom"
                android:background="@drawable/detail_backdrop_gradient"
                android:importantForAccessibility="no" />

            <!--
                Poster အမြင့် 168dp ဖြစ်ပါတယ်။

                translationY="72dp" ကြောင့် poster ရဲ့ 96dp လောက်က
                cover ထဲမှာရှိပြီး ကျန်တဲ့ 72dp က cover အောက်ကို
                ထွက်လာပါမယ်။
            -->
            <ImageView
                android:id="@+id/detailPoster"
                android:layout_width="112dp"
                android:layout_height="168dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="16dp"
                android:background="@drawable/detail_poster_bg"
                android:clipToOutline="true"
                android:contentDescription="Movie poster"
                android:elevation="12dp"
                android:scaleType="centerCrop"
                android:translationY="72dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/detailBackButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="14dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/detail_favorite_bg"
                android:clickable="true"
                android:contentDescription="Back"
                android:elevation="14dp"
                android:focusable="true"
                android:gravity="center"
                android:paddingBottom="4dp"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/favoriteButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/detail_favorite_bg"
                android:contentDescription="Add to favorites"
                android:elevation="14dp"
                android:padding="12dp"
                android:src="@drawable/ic_favorite_border"
                android:tint="@null" />

        </FrameLayout>



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="88dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

     <TextView
    android:id="@+id/detailTitle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxLines="3"
    android:textColor="@color/white"
    android:textSize="24sp"
    android:textStyle="bold" />

<!--
    Movies ဖြစ်လျှင် year/rating ကို ဒီတန်းမှာပြမည်။
    VIP 18+ ဖြစ်လျှင် year/rating အစား VIP badge ကိုပြမည်။
    Free 18+ ဖြစ်လျှင် တန်းတစ်ခုလုံး နေရာမယူပါ။
-->
<LinearLayout
    android:id="@+id/detailMetaRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="7dp">

    <TextView
        android:id="@+id/detailVipBadge"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:background="@drawable/vip_badge_bg"
        android:elevation="7dp"
        android:gravity="center"
        android:minWidth="42dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="VIP"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/detailMeta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/gray_text"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>


            <!-- Genre chips: Action, Drama စသည်တို့သာ ပြမည် -->
<HorizontalScrollView
    android:id="@+id/genresScroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:clipToPadding="false"
    android:scrollbars="none"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/genresContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingEnd="8dp" />

</HorizontalScrollView>


            <LinearLayout
    android:id="@+id/mainActions"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:orientation="vertical">

    <Button
        android:id="@+id/playButton"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:background="@drawable/play_button_bg"
        android:backgroundTint="@null"
        android:elevation="0dp"
        android:gravity="center"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="▶  PLAY"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <Button
        android:id="@+id/downloadButton"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/download_button_bg"
        android:backgroundTint="@null"
        android:elevation="0dp"
        android:gravity="center"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="↓  DOWNLOAD"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

</LinearLayout>


            <!--
                Java code က shareButton နဲ့ telegramButton ID တွေကို
                အသုံးပြုနေသေးတဲ့အတွက် Views တွေကို မဖျက်ဘဲ
                parent container တစ်ခုလုံး GONE လုပ်ထားပါတယ်။

                Screen ပေါ်တွင် button နှင့် နေရာလွတ် လုံးဝမပေါ်ပါ။
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/shareButton"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="Share" />

                <Button
                    android:id="@+id/telegramButton"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="Telegram" />

            </LinearLayout>

            

            <TextView
                android:id="@+id/overviewLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="24dp"
                android:text="ဇာတ်လမ်းအကျဉ်း"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detailOverview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:paddingTop="8dp"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/episodesLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="24dp"
                android:paddingBottom="8dp"
                android:text="Episodes"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/episodesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
