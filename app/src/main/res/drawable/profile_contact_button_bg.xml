<?xml version="1.0" encoding="utf-8"?>
<selector
    xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#187BB5"
                android:endColor="#1591D1" />

            <corners android:radius="16dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#229ED9"
                android:endColor="#37B7F2" />

            <corners android:radius="16dp" />
        </shape>
    </item>

</selector>
