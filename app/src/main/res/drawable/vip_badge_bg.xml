<?xml version="1.0" encoding="utf-8"?>
<selector
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Button နှိပ်ထားချိန် -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">

            <gradient
                android:angle="0"
                android:startColor="#5712AD"
                android:centerColor="#4322D5"
                android:endColor="#1E32D4" />

            <corners android:radius="24dp" />

            <stroke
                android:width="1dp"
                android:color="#6947E8" />

        </shape>
    </item>

    <!-- ပုံမှန်အခြေအနေ -->
    <item>
        <shape android:shape="rectangle">

            <gradient
                android:angle="0"
                android:startColor="#7B16D9"
                android:centerColor="#5924EB"
                android:endColor="#263DFF" />

            <corners android:radius="24dp" />

            <stroke
                android:width="1dp"
                android:color="#7F67FF" />

        </shape>
    </item>

</selector>
