<?xml version="1.0" encoding="utf-8"?>
<selector
    xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">

            <solid android:color="#302A38" />

            <corners android:radius="15dp" />

            <stroke
                android:width="1dp"
                android:color="#5A5264" />

        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">

            <solid android:color="#24202B" />

            <corners android:radius="15dp" />

            <stroke
                android:width="1dp"
                android:color="#433C4C" />

        </shape>
    </item>

</selector>
