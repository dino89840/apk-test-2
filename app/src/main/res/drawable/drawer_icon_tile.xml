<?xml version="1.0" encoding="utf-8"?>
<!--
    Premium icon tile for navigation drawer rows:
    dark gradient rounded tile with a subtle gold stroke,
    matching the app's premium gold aesthetic
    (gold lock/info icons, P-Day crown badge).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="10dp" />

    <gradient
        android:angle="135"
        android:startColor="#262A34"
        android:endColor="#14161C" />

    <stroke
        android:width="1dp"
        android:color="#33E8B93E" />

</shape>
