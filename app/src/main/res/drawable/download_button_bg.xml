<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Button disabled ဖြစ်နေချိန် -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">

            <solid android:color="#2F2F38" />

            <corners android:radius="9dp" />

            <stroke
                android:width="1dp"
                android:color="#454550" />

        </shape>
    </item>

    <!-- နှိပ်ထားချိန် -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">

            <solid android:color="@color/download_button_pressed" />

            <corners android:radius="9dp" />

            <stroke
                android:width="1dp"
                android:color="#5A5A68" />

        </shape>
    </item>

    <!-- ပုံမှန်အခြေအနေ -->
    <item>
        <shape android:shape="rectangle">

            <solid android:color="@color/download_button" />

            <corners android:radius="9dp" />

            <stroke
                android:width="1dp"
                android:color="#4A4A56" />

        </shape>
    </item>

</selector>
