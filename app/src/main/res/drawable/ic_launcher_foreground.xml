<?xml version="1.0" encoding="utf-8"?>
<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Logo ကို adaptive icon safe zone အတွင်း
        ထည့်ထားရန် ဘေးတစ်ဖက်စီ 21dp ချန်ထားသည်။
    -->
    <item
        android:left="21dp"
        android:top="21dp"
        android:right="21dp"
        android:bottom="21dp">

        <bitmap
            android:src="@drawable/my_logo"
            android:gravity="fill"
            android:filter="true" />

    </item>

</layer-list>
