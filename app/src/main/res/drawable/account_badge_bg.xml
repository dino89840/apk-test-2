<?xml version="1.0" encoding="utf-8"?>
<selector
    xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">

            <gradient
                android:angle="0"
                android:startColor="#B80610"
                android:endColor="#D10A14" />

            <corners android:radius="15dp" />

            <stroke
                android:width="1dp"
                android:color="#FF5A62" />

        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">

            <gradient
                android:angle="0"
                android:startColor="#D70712"
                android:endColor="#F01A24" />

            <corners android:radius="15dp" />

            <stroke
                android:width="1dp"
                android:color="#FF424C" />

        </shape>
    </item>

</selector>
